{
  "name": "autocut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx src/server/index.ts\" \"vite\"",
    "server": "tsx src/server/index.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "start": "tsx src/server/index.ts",
    "installer": "bash installer/build.sh",
    "installer:win": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/rebuild.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@remotion/bundler": "4.0.543",
    "@remotion/player": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.543",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.543",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}

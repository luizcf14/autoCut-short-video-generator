# Configurações do AutoCut. O jeito mais fácil de mudar é pela tela: botão "Configurações".
# Se editar aqui, salve e reinicie o AutoCut.
# Linhas começando com # são ignoradas: apague o # para ativar uma opção.

# Chave da API da Anthropic (https://console.anthropic.com). Sem ela, o plano
# é montado só pelo áudio (modo simples, sem Claude).
ANTHROPIC_API_KEY=

# Modelo usado para montar o plano de edição.
CLAUDE_MODEL=claude-fable-5-2

# Pasta onde ficam os vídeos brutos (padrão: a pasta "videos" do AutoCut).
# VIDEOS_DIR=D:\Videos\Brutos

# Pasta onde os vídeos prontos são salvos (padrão: VIDEOS_DIR\prontos).
# OUTPUT_DIR=D:\Videos\Prontos

# Pasta de trabalho (proxy, quadros, recortes). Precisa de espaço livre:
# cerca de 1/3 do tamanho do vídeo bruto. Pode apontar para outro disco.
# WORK_DIR=D:\AutoCut\work

# Opcional: gerador de música de fundo. Basta uma das chaves.
#   Google Lyria: chave grátis para criar em https://aistudio.google.com/apikey (uso é cobrado)
#   ElevenLabs Music: chave em https://elevenlabs.io (plano pago)
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=
# Se tiver as duas, escolha: MUSIC_PROVIDER=gemini ou MUSIC_PROVIDER=elevenlabs

# Pasta com as músicas de fundo (padrão: VIDEOS_DIR\musicas).
# MUSIC_DIR=D:\Videos\Musicas

# Nome que aparece na tela final dos vídeos.
# CHANNEL_NAME=Meu Canal

# Opcional: usar a placa de vídeo na exportação. Teste um de cada vez; se a exportação
# falhar ou ficar mais lenta, apague a linha.
#   RENDER_GL=angle      o Chrome desenha os quadros com a placa (ajuda no fundo desfocado)
#   RENDER_NVENC=1       codifica o vídeo com a placa (só NVIDIA)
#   RENDER_CONCURRENCY=75%   quantos núcleos do processador usar (padrão: metade)
# RENDER_GL=angle
# RENDER_NVENC=1
# RENDER_CONCURRENCY=75%

# Opcional: comando do Whisper para transcrever fala (pip install openai-whisper).
# Se não existir, a transcrição é simplesmente pulada.
# WHISPER_CMD=whisper
# WHISPER_MODEL=small

# Opcional: quantos quadros mandar para o Claude (mais quadros = mais custo).
# MAX_FRAMES=48

# Opcional: máximo de quadros examinados ao detectar apontamentos em um vídeo.
# MAX_POINT_FRAMES=240
